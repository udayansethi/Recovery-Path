# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production
DATABASE_URL=sqlite:///addiction_support.db

# -------------------------------------------------------------
# 100% FREE AI API KEYS CONFIGURATION (Choose either or both)
# -------------------------------------------------------------

# 1. Google Gemini API (Primary - Free Tier: 15 Requests/Min, 1,500 Requests/Day)
# Get your 100% Free API key at: https://aistudio.google.com/
